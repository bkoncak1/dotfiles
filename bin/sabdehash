#!/bin/bash
# Run movedl.py script in sab scripts directory

cd /mnt/md0/sab/scripts || { echo "❌ Could not change to /mnt/md0/sab/scripts"; exit 1; }

# Activate uv virtual environment
if [ -f ".venv/bin/activate" ]; then
    source .venv/bin/activate
elif [ -f "venv/bin/activate" ]; then
    source venv/bin/activate
fi

# Run the script with uv
uv run movedl.py

# Capture exit code
exit_code=$?

# Return to previous directory
cd - > /dev/null

exit $exit_code
