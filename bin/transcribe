#!/bin/bash

# Check if filename argument is provided
if [ $# -eq 0 ]; then
    echo "Usage: transcribe <audio-file> [language]"
    echo "Supported formats: .m4a, .mp3, .wav, .mp4, .mkv, .wmv, .avi, .flac, etc."
    echo ""
    echo "Language codes (optional):"
    echo "  tr - Turkish"
    echo "  en - English (default)"
    echo "  nl - Dutch"
    echo "  fr - French"
    echo "  de - German"
    echo "  es - Spanish"
    echo "  it - Italian"
    echo "  pt - Portuguese"
    echo "  ja - Japanese"
    echo "  zh - Chinese"
    echo "  auto - Auto-detect"
    echo ""
    echo "Example: transcribe recording.m4a tr"
    exit 1
fi

INPUT_FILE="$1"
LANGUAGE="${2:-en}"  # Default to English if not specified

# Check if file exists
if [ ! -f "$INPUT_FILE" ]; then
    echo "Error: File not found: $INPUT_FILE"
    exit 1
fi

BASENAME=$(basename "$INPUT_FILE" | sed 's/\.[^.]*$//')
DIR=$(dirname "$INPUT_FILE")
WAV_FILE="${DIR}/${BASENAME}.wav"

# Convert to WAV format with audio enhancement
echo "Converting and enhancing audio..."
ffmpeg -i "$INPUT_FILE" \
    -af "highpass=f=100,lowpass=f=8000,afftdn=nf=-20,speechnorm=e=12.5:r=0.0001:l=1,acompressor=threshold=-20dB:ratio=4:attack=5:release=50" \
    -ar 16000 -ac 1 -c:a pcm_s16le "$WAV_FILE" -y -loglevel error

if [ $? -ne 0 ]; then
    echo "Error: FFmpeg conversion failed"
    exit 1
fi

# Run whisper transcription with anti-hallucination settings
echo "Transcribing in $LANGUAGE..."
~/Developer/tools/whisper.cpp/build/bin/whisper-cli \
    -m ~/Developer/tools/whisper.cpp/models/ggml-large-v3.bin \
    -l "$LANGUAGE" \
    -t 12 \
    -p 1 \
    -et 2.4 \
    -mc 0 \
    -sns \
    -otxt \
    -ojf \
    -f "$WAV_FILE"

if [ $? -eq 0 ]; then
    # Rename output files to remove .wav extension
    if [ -f "${WAV_FILE}.txt" ]; then
        mv "${WAV_FILE}.txt" "${DIR}/${BASENAME}.txt"
    fi
    if [ -f "${WAV_FILE}.json" ]; then
        mv "${WAV_FILE}.json" "${DIR}/${BASENAME}.json"
    fi
    
    # Remove temporary WAV file
    rm "$WAV_FILE"
    
    echo "Done! Output files: ${BASENAME}.txt and ${BASENAME}.json"
else
    echo "Error: Transcription failed"
    rm -f "$WAV_FILE"  # Clean up WAV file even on failure
    exit 1
fi